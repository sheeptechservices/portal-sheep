{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "devCommand": "npm run dev:vite",
  "functions": {
    "api/*.ts": {
      "includeFiles": "node_modules/@libsql/**,node_modules/pdfkit/**,node_modules/fontkit/**,node_modules/linebreak/**,api/_templates/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
